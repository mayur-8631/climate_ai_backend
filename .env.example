# ClimateTwin AI - Environment Configuration
PROJECT_NAME="ClimateTwin AI Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server & CORS Settings (for Pravin's Next.js Frontend)
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Connection (Supabase / PostgreSQL or Local SQLite fallback)
DATABASE_URL="sqlite:///./climatetwin.db"
# Example Supabase Postgres URL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# External Data APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1"

# Optional Fallback API Keys (leave blank to use Open-Meteo direct)
OPENWEATHERMAP_API_KEY=""
WAQI_API_TOKEN=""

# Default Pilot Location: Pune, Maharashtra, India
DEFAULT_LOCATION_NAME="Pune"
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567
DEFAULT_ELEVATION=560.0

# Cache & Request Timeouts
REQUEST_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=300

